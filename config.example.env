# Copy to .env locally. Never commit .env. Provider requests run only via explicit CLI commands.
# SEC_USER_AGENT is also supported. Process environment values override this file.
BAGHUNTER_SEC_USER_AGENT=YourOrganization your-contact@example.com
# Existing Finviz Elite token; no subscription is created by this application.
FINVIZ_TOKEN=
BAGHUNTER_DATA=data/fixture/latest
